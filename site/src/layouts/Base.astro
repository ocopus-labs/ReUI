---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400-italic.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** A page that isn't part of the site (the README pictures' stage): no grain, not indexed. */
  bare?: boolean;
}
const { title, description, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {bare && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ReUI" />
    {/* The link-preview card (`npm run og-image`). Without one, chat apps and social sites
        pick any picture off the page, such as the island's album cover. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ReUI: the Dynamic Island for Windows" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#efeee9" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
    {!bare && <div class="grain" aria-hidden="true"></div>}
    <script>
      import Lenis from 'lenis';

      // Smooth scrolling for the whole page. The scroll-driven scenes read the real scroll
      // position, which Lenis moves, so they follow it. Off with reduced motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        (window as unknown as { lenis: Lenis }).lenis = new Lenis({ autoRaf: true, lerp: 0.1 });
      }
    </script>
  </body>
</html>
