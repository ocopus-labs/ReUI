---
// The top bar of the site's reading pages (guide, changelog): home, the two of them, and
// Download. `current` marks the page you're on.
interface Props {
  current?: 'guide' | 'changelog';
}
const { current } = Astro.props;
const repo = 'https://github.com/ocopus-labs/ReUI';
---
<header class="bar">
  <a class="brand" href="/"><img src="/favicon.png" width="22" height="22" alt="" />ReUI</a>
  <nav aria-label="Main">
    <a href="/guide" aria-current={current === 'guide' ? 'page' : undefined}>Guide</a>
    <a href="/changelog" aria-current={current === 'changelog' ? 'page' : undefined}>What’s new</a>
    <a class="pill-link" href={`${repo}/releases/latest`}>Download</a>
  </nav>
</header>

<style>
  .bar { display: flex; align-items: center; justify-content: space-between; height: 58px; padding: 0 var(--gutter); }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 600; font-size: 15px; }
  .brand img { border-radius: 5px; }
  nav { display: flex; align-items: center; gap: 22px; font-size: 14px; }
  nav a { color: rgb(14 14 16 / 0.65); transition: color 0.2s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  .pill-link { padding: 7px 14px; border-radius: 999px; background: var(--ink); color: #fff !important; font-weight: 500; }
</style>
