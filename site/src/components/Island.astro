---
// The page's own island, fixed at the top of the window like ReUI's at the top of the
// screen. Same geometry and colours as the app (design/tokens.json); its moments are
// layers that fade over the shape while the shape springs to their size. Icons are the
// real ones (src/scripts/icons.ts): Fluent glyphs, the agents' logos, ReUI's device marks.
import { icons } from '../scripts/icons';
// What's playing: a real track (Blinding Lights, The Weeknd, After Hours, 3:20) in Spotify,
// its cover from Apple's iTunes Search API.
import cover from '../assets/now-playing.jpg';

// The places, in the app's tab order (hub/src/modules/destinations.rs), and the card each opens.
const places = [
  { id: 'clipboard', name: 'Clipboard', icon: 'paste', card: 'clipboard' },
  { id: 'shelf', name: 'Shelf', icon: 'box', card: 'shelf-card' },
  { id: 'timers', name: 'Timers', icon: 'timer', card: 'launcher' },
  { id: 'calendar', name: 'Calendar', icon: 'calendar', card: 'calendar-card' },
  { id: 'devices', name: 'Devices', icon: 'devices', card: 'devices-card' },
  { id: 'stats', name: 'System stats', icon: 'pulse', card: 'stats-card' },
  { id: 'media', name: 'Now Playing', icon: 'music', card: 'now-playing' },
] as const;
---
<div class="island" data-island aria-label="ReUI's island" role="img">
  <span class="ear left" data-ear="left"></span>
  <span class="ear right" data-ear="right"></span>
  <div class="pill" data-pill>
    <div class="layer idle" data-moment="idle" data-w="120" data-h="36.67"></div>

    <div class="layer compact music" data-moment="music" data-w="116" data-h="36.67">
      <img class="art" src={cover.src} alt="" width="24" height="24" />
      <span class="bars"><i></i><i></i><i></i><i></i></span>
    </div>

    <div class="layer compact joined" data-moment="copied" data-w="120" data-h="36.67">
      <i class="ico glyph" set:html={icons.paste}></i>
      <span class="label">Copied</span>
    </div>

    <div class="layer compact meter" data-moment="volume" data-w="200" data-h="36.67">
      <span class="level"><i class="ico glyph" set:html={icons.speaker}></i></span>
      <span class="value">56%</span>
    </div>

    <div class="layer compact timer" data-moment="timer" data-w="120" data-h="36.67">
      <span class="tea">3:42</span>
      <svg class="ring" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" class="track" /><circle cx="12" cy="12" r="9.5" class="arc" /></svg>
    </div>

    <div class="layer compact joined agent" data-moment="agent" data-w="120" data-h="36.67">
      <i class="ico glyph spark" set:html={icons.claude}></i>
      <span class="label">Allow?</span>
    </div>

    <div class="layer expanded now-playing" data-moment="now-playing" data-w="420" data-h="217">
      <div class="head">
        <img class="tile cover" src={cover.src} alt="After Hours, the album" width="56" height="56" />
        <span class="text">
          <span class="eyebrow">Spotify</span>
          <span class="hero">Blinding Lights</span>
          <span class="detail">The Weeknd</span>
        </span>
        <span class="bars"><i></i><i></i><i></i><i></i></span>
      </div>
      <div class="progress"><span></span></div>
      <div class="transport">
        <span class="caption">1:00</span>
        <span class="controls">
          <i class="ico" set:html={icons.previous}></i>
          <span class="play"><i class="ico" set:html={icons.pause}></i></span>
          <i class="ico" set:html={icons.next}></i>
        </span>
        <span class="caption">-2:20</span>
      </div>
      <div class="volume">
        <i class="ico" set:html={icons.speaker}></i>
        <span class="slider"><span></span></span>
      </div>
    </div>

    <div class="layer expanded timer-card" data-moment="timer-card" data-w="420" data-h="118">
      <svg class="big-ring" viewBox="0 0 56 56"><circle cx="28" cy="28" r="23" class="track" /><circle cx="28" cy="28" r="23" class="arc" /></svg>
      <span class="text">
        <span class="eyebrow">Tea</span>
        <span class="numerals">3:42</span>
        <span class="detail">Ends 3:46 PM</span>
      </span>
      <span class="round tinted"><i class="ico" set:html={icons.pause}></i></span>
      <span class="round"><i class="ico" set:html={icons.dismiss}></i></span>
    </div>

    <div class="layer expanded permission" data-moment="permission" data-w="480" data-h="200">
      <div class="context">
        <i class="ico spark" set:html={icons.claude}></i>
        <span><b>reui</b> · Run the tests and fix what fails · 4m</span>
      </div>
      <div class="ask">
        <i class="ico term" set:html={icons.terminal}></i>
        <span class="text">
          <span class="eyebrow">Permission</span>
          <span class="chip">npm test</span>
          <span class="detail">Run the test suite</span>
        </span>
      </div>
      <div class="buttons">
        <button type="button" data-answer="deny">Deny</button>
        <button type="button" data-answer="always">Always</button>
        <button type="button" data-answer="allow" class="accent">Allow</button>
      </div>
    </div>

    <!-- Claude's question (agent/card.rs Kind::Question): the options as choices. -->
    <div class="layer expanded agent-card question" data-moment="question" data-w="480" data-h="318">
      <div class="context">
        <i class="ico spark" set:html={icons.claude}></i>
        <span><b>reui</b> · Run the tests and fix what fails · 5m</span>
      </div>
      <div class="ask">
        <i class="ico term" set:html={icons.question}></i>
        <span class="text">
          <span class="eyebrow">Question</span>
          <span class="hero">How should the retry wait?</span>
          <span class="detail">Retry</span>
        </span>
      </div>
      <div class="choices">
        <button type="button" data-action="pick:0" data-choice="0"><i></i><span><b>Exponential backoff</b><small>Doubles from 100 ms, up to 5 tries</small></span></button>
        <button type="button" data-action="pick:1" data-choice="1"><i></i><span><b>Fixed 250 ms</b><small>Simplest</small></span></button>
      </div>
      <div class="buttons two">
        <button type="button" class="plain" data-action="terminal">Answer in terminal</button>
        <button type="button" class="accent" data-action="send" data-send>Send</button>
      </div>
    </div>

    <!-- Claude's plan (Kind::Plan): its title, file and steps, the prose, two answers. -->
    <div class="layer expanded agent-card plan" data-moment="plan" data-w="480" data-h="300">
      <div class="context">
        <i class="ico spark" set:html={icons.claude}></i>
        <span><b>reui</b> · Run the tests and fix what fails · 6m</span>
      </div>
      <div class="ask">
        <i class="ico term" set:html={icons.plan}></i>
        <span class="text">
          <span class="eyebrow">Plan</span>
          <span class="hero">Back off between upload retries</span>
          <span class="detail">upload-retries.md · 3 steps</span>
        </span>
      </div>
      <p class="prose">Add a backoff helper that doubles from 100 ms, use it in <code>retry()</code>, and make the flaky test wait on the helper instead of the clock.</p>
      <div class="buttons two">
        <button type="button" data-action="keep">Keep planning</button>
        <button type="button" class="accent" data-action="approve">Approve</button>
      </div>
    </div>

    <!-- A turn that ended well: Claude's mark and a check (a bare glyph: just the two). -->
    <div class="layer compact joined agent" data-moment="agent-done" data-w="auto" data-floor="0" data-h="36.67">
      <i class="ico glyph spark" set:html={icons.claude}></i>
      <i class="ico glyph" style="color: var(--green)" set:html={icons.check}></i>
    </div>

    <div class="layer compact joined agent" data-moment="allowed" data-w="120" data-h="36.67">
      <i class="ico glyph" set:html={icons.check}></i>
      <span class="label">Allowed</span>
    </div>

    <div class="layer compact joined" data-moment="denied" data-w="120" data-h="36.67">
      <i class="ico glyph" set:html={icons.dismiss}></i>
      <span class="label">Denied</span>
    </div>

    <!-- The timer field (Win+Ctrl+T): what Enter will start, the field, the presets. -->
    <div class="layer expanded launcher" data-moment="launcher" data-w="420" data-h="200">
      <div class="header">
        <span class="tile orange"><i class="ico" set:html={icons.timer}></i></span>
        <span class="text">
          <span class="eyebrow" data-field="eyebrow">Timer</span>
          <span class="numerals" data-field="hero">25:00</span>
          <span class="detail" data-field="detail"></span>
        </span>
      </div>
      <div class="search field">
        <i class="ico" set:html={icons.timer}></i>
        <span data-field="query" data-empty>25m</span><i class="caret"></i>
      </div>
      <div class="buttons presets">
        <button type="button" data-action="preset:5">5 min</button>
        <button type="button" data-action="preset:10">10 min</button>
        <button type="button" data-action="preset:25">25 min</button>
      </div>
    </div>

    <!-- A running timer from the field, counting down. -->
    <div class="layer compact timer countdown" data-moment="countdown" data-w="120" data-h="36.67">
      <span class="tea" data-field="time">10:00</span>
      <svg class="ring" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" class="track" /><circle cx="12" cy="12" r="9.5" class="arc" data-field="arc" /></svg>
    </div>

    <!-- A bell and a word: "Done", or a reminder's time once it's kept. -->
    <div class="layer compact joined bell-line" data-moment="bell" data-w="120" data-h="36.67">
      <i class="ico glyph" set:html={icons.alert}></i>
      <span class="label" data-field="label">Done</span>
    </div>

    <!-- An ended timer or a due reminder: bell, what, when, two answers. -->
    <div class="layer expanded alert" data-moment="alert" data-w="420" data-h="156">
      <div class="header">
        <span class="tile orange"><i class="ico" set:html={icons.alert}></i></span>
        <span class="text">
          <span class="eyebrow" data-field="eyebrow">Timer</span>
          <span class="hero" data-field="hero">Done</span>
          <span class="detail" data-field="detail">10 min timer</span>
        </span>
      </div>
      <div class="buttons two">
        <button type="button" data-field="secondary" data-action="secondary">+1 min</button>
        <button type="button" class="accent" data-field="primary" data-action="primary">Stop</button>
      </div>
    </div>

    <!-- The rest of the day: compact moments, worded as the app words them
         (devices/view.rs, privacy/call_view.rs, downloads/view.rs, activities/view.rs,
         calendar/view.rs, stats/view.rs, shelf/card.rs, the island's pill/drop.rs). -->
    <div class="layer compact" data-moment="earbuds" data-w="120" data-h="36.67" style="--tone: var(--blue)">
      <span class="mark"><i class="ico" set:html={icons.earbuds}></i></span>
      <svg class="ring" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" class="track" /><circle cx="12" cy="12" r="9.5" class="arc" style="stroke-dashoffset: 10.7" /></svg>
    </div>

    <!-- Earbuds connecting, open (devices/view.rs connect_view): the mark, Connected, the
         name, model · battery, the battery ring. -->
    <div class="layer expanded earbuds-card" data-moment="earbuds-card" data-w="420" data-h="96" style="--tone: var(--blue)">
      <span class="tile device-tile"><i class="ico" set:html={icons.earbuds}></i></span>
      <span class="text">
        <span class="eyebrow">Connected</span>
        <span class="hero">Galaxy Buds2 Pro</span>
        <span class="detail">Samsung · 82%</span>
      </span>
      <svg class="big-ring" viewBox="0 0 56 56"><circle cx="28" cy="28" r="23" class="track" /><circle cx="28" cy="28" r="23" class="arc" style="stroke-dashoffset: 26" /></svg>
    </div>

    <div class="layer compact" data-moment="call" data-w="132" data-h="36.67" style="--tone: var(--green)">
      <span class="app" style="background:#0b5cff" set:html={icons.zoom}></span>
      <span class="clock green" data-field="clock">0:42</span>
    </div>

    <div class="layer compact joined" data-moment="mic" data-w="auto" data-floor="0" data-h="36.67" style="--tone: var(--orange)">
      <span class="app" style="background:#5865f2" set:html={icons.discord}></span>
      <i class="ico glyph toned" set:html={icons.mic}></i>
    </div>

    <div class="layer compact joined" data-moment="download" data-w="auto" data-h="36.67" style="--tone: var(--green)">
      <svg class="ring" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" class="track" /><circle cx="12" cy="12" r="9.5" class="arc" data-field="arc" /></svg>
      <span class="label quiet" data-field="label">48 MB · setup.exe</span>
    </div>

    <div class="layer compact" data-moment="activity" data-w="120" data-h="36.67" style="--tone: var(--blue)">
      <svg class="ring" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" class="track" /><circle cx="12" cy="12" r="9.5" class="arc" data-field="arc" /></svg>
      <span class="label" data-field="label">42%</span>
    </div>

    <div class="layer compact joined" data-moment="activity-done" data-w="auto" data-h="36.67" style="--tone: var(--green)">
      <i class="ico glyph toned" set:html={icons.check}></i>
      <span class="label toned">Done</span>
    </div>

    <div class="layer compact joined" data-moment="meeting" data-w="auto" data-h="36.67" style="--tone: var(--red)">
      <svg class="ring" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" class="track" /><circle cx="12" cy="12" r="9.5" class="arc" data-field="arc" style="stroke-dashoffset: 30" /></svg>
      <span class="label">Design review</span>
    </div>

    <div class="layer compact" data-moment="stats" data-w="120" data-h="36.67" style="--tone: var(--teal)">
      <svg class="ring" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" class="track" /><circle cx="12" cy="12" r="9.5" class="arc" data-field="arc" style="stroke-dashoffset: 46" /></svg>
      <span class="label" data-field="label">23%</span>
    </div>

    <div class="layer compact joined" data-moment="shelf-drop" data-w="auto" data-h="42.67">
      <i class="ico glyph" set:html={icons.box}></i>
      <span class="label quiet">Drop to hold</span>
    </div>

    <div class="layer compact" data-moment="shelf" data-w="120" data-h="36.67" style="--tone: #30b0c7">
      <i class="ico glyph toned" set:html={icons.box}></i>
      <span class="label quiet" data-field="count"></span>
    </div>

    <!-- The resting pill, clicked: the row of places (DESIGN.md "Idle"): the view switcher's
         destinations as glyph tabs, no labels, the pill as wide as the row. -->
    <div class="layer places" data-moment="places" data-w="232.7" data-h="36.67">
      {places.map((p) => <button type="button" class="place" data-place={p.id} data-card={p.card} aria-label={p.name} set:html={icons[p.icon]}></button>)}
    </div>

    <!-- Shelf (shelf/card.rs): eyebrow, a bin, the held items newest first. Wide. -->
    <div class="layer expanded shelf-card" data-moment="shelf-card" data-w="560" data-h="196">
      <div class="bar-head"><span class="eyebrow" style="color:#30b0c7">Shelf</span><i class="ico head-button" set:html={icons.bin}></i></div>
      <div class="clips">
        <span class="clip"><i class="ico file-mark" set:html={icons.document}></i><b>Q3-report.pdf</b><span class="foot"><span>now</span><span>PDF</span></span></span>
        <span class="clip photo"><span class="foot"><span>2m</span><span>PNG</span></span></span>
        <span class="clip"><i class="ico file-mark" style="color: var(--blue)" set:html={icons.globe}></i><b>Brand guidelines</b><span class="foot"><span>9m</span><span>figma.com</span></span></span>
        <span class="clip"><b>Ship notes</b><span class="body">Calendar beta, the notch, faster stats…</span><span class="foot"><span>1h</span><span>3 lines</span></span></span>
        <span class="clip fade"><i class="ico file-mark" set:html={icons.document}></i><b>invoice-0412.pdf</b><span class="foot"><span>2h</span></span></span>
      </div>
    </div>

    <!-- Calendar (calendar/view.rs): the next meeting, Join in the header, the rest of the day. -->
    <div class="layer expanded calendar-card" data-moment="calendar-card" data-w="420" data-h="170" style="--tone: var(--red)">
      <div class="header">
        <svg class="big-ring" viewBox="0 0 56 56"><circle cx="28" cy="28" r="23" class="track" /><circle cx="28" cy="28" r="23" class="arc" /></svg>
        <span class="text">
          <span class="eyebrow">Calendar</span>
          <span class="hero">Design review</span>
          <span class="detail">10:00 – 10:30 · Teams</span>
        </span>
        <span class="join">Join</span>
      </div>
      <div class="agenda">
        <span><b>11:30</b><span>Lunch with Sam</span><em>Café Rio</em></span>
        <span><b>14:00</b><span>Q3 planning</span><em>Room 4</em></span>
      </div>
    </div>

    <!-- Devices (devices/view.rs overview): each device with its battery. -->
    <div class="layer expanded devices-card" data-moment="devices-card" data-w="420" data-h="176" style="--tone: var(--blue)">
      <span class="eyebrow">Devices</span>
      <div class="device"><i class="ico" set:html={icons.earbuds}></i><span>Galaxy Buds2 Pro</span><span class="meter-row"><i style="width:82%"></i></span><b>82%</b></div>
      <div class="device"><i class="ico" set:html={icons.headphones}></i><span>WH-1000XM5</span><span class="meter-row"><i style="width:64%"></i></span><b>64%</b></div>
      <div class="device"><i class="ico" set:html={icons.devices}></i><span>This PC</span><span class="meter-row charging"><i style="width:76%"></i></span><b>Charging · 76%</b></div>
    </div>

    <!-- System stats (stats/view.rs): CPU and memory gauges, then GPU, disk and network. Roomy. -->
    <div class="layer expanded stats-card" data-moment="stats-card" data-w="480" data-h="214" style="--tone: var(--teal)">
      <div class="bar-head"><span class="eyebrow">System</span><i class="ico head-button" set:html={icons.pulse}></i></div>
      <div class="gauges">
        <div class="gauge"><svg class="big-ring" viewBox="0 0 56 56"><circle cx="28" cy="28" r="23" class="track" /><circle cx="28" cy="28" r="23" class="arc" style="stroke-dashoffset: 133" /></svg><span><small>CPU</small><b>8<i>%</i></b><em>2.4 GHz</em></span></div>
        <div class="gauge"><svg class="big-ring" viewBox="0 0 56 56"><circle cx="28" cy="28" r="23" class="track" /><circle cx="28" cy="28" r="23" class="arc" style="stroke-dashoffset: 84" /></svg><span><small>Memory</small><b>42<i>%</i></b><em>13.4 of 31.9 GB</em></span></div>
      </div>
      <div class="facts"><span><small>GPU</small>4% · 826 MB</span><span><small>Disk</small>1%</span><span><small>Network</small>↓ 1.8 MB/s  ↑ 120 KB/s</span></div>
    </div>

    <div class="layer expanded clipboard" data-moment="clipboard" data-w="560" data-h="240">
      <div class="search">
        <i class="ico" set:html={icons.search}></i>
        <span>Search</span>
      </div>
      <div class="tabs"><span class="on">History <i>24</i></span><span>Pinned <i>3</i></span></div>
      <div class="clips">
        <span class="clip"><b>Thursday</b><span class="body">Move the review to 3 PM and send the agenda…</span><span class="foot"><span>now</span><span>2 lines</span></span></span>
        <span class="clip"><i class="ico globe" set:html={icons.globe}></i><b>Keyboard shortcuts in Windows</b><span class="foot"><span>4m</span><span>microsoft.c…</span></span></span>
        <span class="clip colour"><b>#5E5CE6</b><span class="foot"><span>18m</span><span>HEX</span></span></span>
        <span class="clip code"><code>npm run build</code><span class="foot"><span>1h</span></span></span>
        <span class="clip fade"><span class="body">See you at the station</span><span class="foot"><span>2h</span></span></span>
      </div>
    </div>
  </div>
  <!-- The view switcher (PRD-view-switcher.md): under an open place, the places as glyph
       tabs in a capsule as tall as the island, the open one filled. -->
  <div class="switcher" data-switcher>
    {places.map((p) => <button type="button" class="place" data-place={p.id} data-card={p.card} aria-label={p.name} set:html={icons[p.icon]}></button>)}
  </div>
  <div class="bubble" data-bubble>
    <svg class="ring" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" class="track" /><circle cx="12" cy="12" r="9" class="arc" /></svg>
  </div>
</div>

<style>
  .island {
    --primary: #ebebf0;
    --secondary: #8e8d94;
    --tertiary: rgb(235 235 245 / 0.3);
    --track: rgb(255 255 255 / 0.16);
    --shape: #000;
    --fill: rgb(255 255 255 / 0.16);
    --fill-soft: rgb(255 255 255 / 0.1);
    --fill-hover: rgb(255 255 255 / 0.24);
    --card: #1c1c1e;
    --level: #0d3a6e;
    --pink: #ff375f;
    --orange: #ff9f0a;
    --blue: #0a84ff;
    --green: #30d158;
    --red: #ff453a;
    --teal: #40c8e0;
    position: fixed;
    top: 11px;
    left: 50%;
    transform-origin: 0 0;
    z-index: 50;
    height: 0;
    font-family: "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
    color: var(--primary);
    -webkit-font-smoothing: antialiased;
    transition: top 0.45s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  /* Notch: flush with the top edge (docs/PRD-appearance.md). */
  .island.notch { top: 0; }
  /* Light: tokens theme.light. */
  .island.light {
    --primary: #000;
    --secondary: rgb(60 60 67 / 0.6);
    --tertiary: rgb(60 60 67 / 0.3);
    --track: rgb(0 0 0 / 0.1);
    --shape: #fff;
    --fill: rgb(120 120 128 / 0.16);
    --fill-soft: rgb(120 120 128 / 0.12);
    --fill-hover: rgb(120 120 128 / 0.24);
    --card: #f2f2f4;
    --level: #cfe3ff;
    --pink: #ff2d55;
    --orange: #ff9500;
    --green: #34c759;
    --red: #ff3b30;
  }
  /* The ears: concave joins between the screen's edge and the notch's sides
     (radius notch.ear). */
  .ear {
    position: absolute;
    top: 0;
    width: 8px;
    height: 8px;
    opacity: 0;
    transition: opacity 0.25s ease, background 0.35s ease;
    pointer-events: none;
  }
  .ear.left { background: radial-gradient(circle at 0 100%, transparent 7.6px, var(--shape) 8px); }
  .ear.right { background: radial-gradient(circle at 100% 100%, transparent 7.6px, var(--shape) 8px); }
  .island.notch .ear { opacity: 1; transition-delay: 0.12s; }
  /* Hidden (as in ReUI's hide-until-needed modes): shrinks to motion.show.from-scale. */
