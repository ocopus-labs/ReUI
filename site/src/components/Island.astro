<script>
  import { Spring, springs } from '../scripts/spring';

  const root = document.querySelector<HTMLElement>('[data-island]')!;
  const pill = root.querySelector<HTMLElement>('[data-pill]')!;
  const bubble = root.querySelector<HTMLElement>('[data-bubble]')!;
  const switcher = root.querySelector<HTMLElement>('[data-switcher]')!;
  const earLeft = root.querySelector<HTMLElement>('[data-ear="left"]')!;
  const earRight = root.querySelector<HTMLElement>('[data-ear="right"]')!;
  const layers = new Map([...root.querySelectorAll<HTMLElement>('[data-moment]')].map((el) => [el.dataset.moment!, el]));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  const w = new Spring(120);
  const h = new Spring(36.67);
  let current = 'idle';
  let peeking = false;
  let frame = 0;
  let last = 0;

  const PEEK_GROW = 6;
  const BUBBLE_GAP = 11;
  // Notch tokens: the ears' radius, the idle notch, the join to the second activity.
  const EAR = 8;
  const NOTCH_IDLE = { w: 104, h: 30 };
  const NOTCH_JOIN = 2;
  const MINIMAL = 36.67;

  let notch = false;
  let withBubble = false;

  function size(name: string) {
    if (notch && name === 'idle') return NOTCH_IDLE;
    const el = layers.get(name)!;
    const h = Number(el.dataset.h);
    if (el.dataset.w !== 'auto') return { w: Number(el.dataset.w), h };
    // A joined label: as wide as its mark and text (offsetWidth ignores the scale it
    // fades in from), never narrower than the resting pill. A mark and a bare glyph
    // (`data-floor="0"`) are just the two: a glyph has no length to fill the resting
    // width, so a floor would only move the empty space to the end (DESIGN.md).
    el.style.right = 'auto';
    el.style.width = 'max-content';
    const w = el.offsetWidth;
    el.style.right = '';
    el.style.width = '';
    return { w: Math.max(Number(el.dataset.floor ?? 120), Math.ceil(w)), h };
  }

  function draw() {
    pill.style.width = `${w.value}px`;
    pill.style.height = `${h.value}px`;
    // Round while a capsule; the card's corner once it's taller. A notch's top corners
    // are square, joined to the edge by the ears.
    const r = Math.min(h.value / 2, 44);
    pill.style.borderRadius = notch ? `0 0 ${r}px ${r}px` : `${r}px`;
    const half = w.value / 2;
    bubble.style.left = `${half + (notch ? NOTCH_JOIN : BUBBLE_GAP)}px`;
    earLeft.style.left = `${-half - EAR}px`;
    // The switcher rides the card's height, switcher.gap under it.
    switcher.style.top = `${h.value + 8}px`;
    earRight.style.left = `${notch && withBubble ? half + NOTCH_JOIN + MINIMAL : half}px`;
  }

  function tick(now: number) {
    const dt = Math.min((now - last) / 1000, 1 / 30);
    last = now;
    const moving = [w.step(dt), h.step(dt)].some(Boolean);
    draw();
    frame = moving ? requestAnimationFrame(tick) : 0;
  }

  function animate() {
    if (reduced.matches) {
      for (const s of [w, h]) s.preset = springs.reduced;
    }
    if (!frame) {
      last = performance.now();
      frame = requestAnimationFrame(tick);
    }
  }

  function target(name: string, grow: number) {
    const s = size(name);
    const expanding = s.h > h.value;
    const preset = expanding ? springs.expand : springs.collapse;
    w.to(s.w + grow, grow ? springs.peek : preset);
    h.to(s.h + grow, grow ? springs.peek : preset);
    animate();
  }

  /** Brings a moment to the front: the shape springs to its size, its content fades in. */
  function show(name: string, options: { bubble?: boolean } = {}) {
    if (!layers.has(name)) return;
    if (name !== current) {
      layers.get(current)?.classList.remove('shown');
      layers.get(name)!.classList.add('shown');
      current = name;
    }
    peeking = false;
    const s = size(name);
    withBubble = !!options.bubble && s.h < 40;
    const place = [...switcher.querySelectorAll<HTMLElement>('[data-place]')].find((b) => b.dataset.card === name);
    switcher.classList.toggle('shown', !!place);
    switcher.querySelectorAll<HTMLElement>('[data-place]').forEach((b) => b.toggleAttribute('data-on', b === place));
    bubble.classList.toggle('shown', withBubble);
    target(name, 0);
    draw();
    root.dataset.state = name;
    dispatchEvent(new CustomEvent('island:change', { detail: name }));
  }

  function peek(on: boolean) {
    if (peeking === on || size(current).h > 40) return;
    peeking = on;
    target(current, on ? PEEK_GROW : 0);
  }

  // The hero's loop: what a morning at the PC brings to the island, until the visitor
  // takes over (a rest, a click, a section that asks for its own moment).
  const loop: [string, number, boolean?][] = [
    ['idle', 2600],
    ['music', 3400],
    ['copied', 2000],
    ['volume', 2000],
    ['timer', 2600],
    ['agent', 2800],
  ];
  let step = 0;
  let timer = 0;
  let held = false;

  function next() {
    const [name, ms, withBubble] = loop[step % loop.length];
    step++;
    show(name, { bubble: withBubble });
    timer = window.setTimeout(next, ms);
  }
  // A section that drives the island (the close-up, the browser) owns it until that same
  // section lets go; another section letting go of nothing changes nothing.
  let driven = false;
  let driver = '';
  function drive(name: string | null, owner: string) {
    if (name) {
      driven = true;
      driver = owner;
      clearTimeout(timer);
      if (name !== current) show(name);
    } else if (driven && driver === owner) {
      driven = false;
      driver = '';
      hold(false);
    }
  }

  function hold(on: boolean) {
    if (!on && driven) return;
    held = on;
    clearTimeout(timer);
    if (!on) timer = window.setTimeout(next, 1200);
  }

  let rest = 0;
  let collapse = 0;
  pill.addEventListener('pointerenter', () => {
    clearTimeout(collapse);
    collapse = 0;
    hold(true);
    rest = window.setTimeout(() => peek(true), 250);
  });
  // Each compact moment opens its own card, as in ReUI (a level has none); the resting
  // pill opens the row of places, a place opens its card, and a card folds back to
  // wherever it was opened from.
  const opens: Record<string, string> = { music: 'now-playing', copied: 'clipboard', timer: 'timer-card', agent: 'permission', idle: 'places', earbuds: 'earbuds-card' };
  const folds: Record<string, string> = Object.fromEntries(Object.entries(opens).map(([compact, card]) => [card, compact]));
  const placeCards = new Map([...switcher.querySelectorAll<HTMLElement>('[data-place]')].map((b) => [b.dataset.place!, b.dataset.card!]));
  const isPlace = (name: string) => [...placeCards.values()].includes(name);
  const fold = () => show(folds[current] ?? 'idle');
  function openPlace(id: string) {
    const card = placeCards.get(id);
    if (!card) return;
    // From the row of places (or another place), the card folds back to the resting pill.
    if (current === 'places' || isPlace(current)) folds[card] = folds[current] === 'places' || current === 'places' ? 'idle' : folds[current] ?? 'idle';
    show(card);
  }
  for (const b of switcher.querySelectorAll<HTMLElement>('[data-place]')) b.addEventListener('click', () => openPlace(b.dataset.place!));

  // Where the pointer is: a card that changes height moves the switcher out from under a
  // pointer that never left, so a fold first checks it's really gone.
  let pointer = { x: -1, y: -1 };
  // Where the switcher was when it was clicked: still the island's until the pointer moves out.
  let zone: { left: number; right: number; top: number; bottom: number } | null = null;
  const inZone = () => !!zone && pointer.x >= zone.left && pointer.x <= zone.right && pointer.y >= zone.top && pointer.y <= zone.bottom;
  addEventListener('pointermove', (e) => {
    pointer = { x: e.clientX, y: e.clientY };
    if (zone && !inZone()) zone = null;
  }, { passive: true });
  switcher.addEventListener('click', () => {
    const r = switcher.getBoundingClientRect();
    zone = { left: r.left - 12, right: r.right + 12, top: r.top - 12, bottom: r.bottom + 12 };
  }, { capture: true });
  function stillOver() {
    const a = pill.getBoundingClientRect();
    const b = switcher.classList.contains('shown') ? switcher.getBoundingClientRect() : a;
    const left = Math.min(a.left, b.left) - 12;
    const right = Math.max(a.right, b.right) + 12;
    return inZone() || (pointer.x >= left && pointer.x <= right && pointer.y >= a.top && pointer.y <= Math.max(a.bottom, b.bottom) + 12);
  }
  function leave() {
    clearTimeout(collapse);
    collapse = window.setTimeout(() => {
      collapse = 0;
      if (stillOver()) return;
      if (folds[current] || isPlace(current)) fold();
      hold(false);
    }, 450);
  }
  // A pointer left in the gap when a card shrank: leaving from there folds it.
  addEventListener('pointermove', () => {
    if ((isPlace(current) || folds[current]) && !stillOver() && !collapse) leave();
  }, { passive: true });
  pill.addEventListener('pointerleave', () => {
    clearTimeout(rest);
    peek(false);
    leave();
  });
  // The switcher is part of the island: moving onto it keeps the card open.
  switcher.addEventListener('pointerenter', () => {
    clearTimeout(collapse);
    collapse = 0;
  });
  switcher.addEventListener('pointerleave', leave);
  pill.addEventListener('click', (event) => {
    clearTimeout(rest);
    // A card's own buttons (presets, Stop, Snooze…) belong to the section driving it.
    const place = (event.target as HTMLElement).closest<HTMLElement>('[data-place]')?.dataset.place;
    if (place) return openPlace(place);
    const action = (event.target as HTMLElement).closest<HTMLElement>('[data-action]')?.dataset.action;
    if (action) {
      dispatchEvent(new CustomEvent('island:action', { detail: { moment: current, action } }));
      return;
    }
    const answer = (event.target as HTMLElement).closest<HTMLElement>('[data-answer]')?.dataset.answer;
    // A section playing an agent's session takes the answer itself.
    if (answer && driven) {
      dispatchEvent(new CustomEvent('island:action', { detail: { moment: current, action: answer } }));
      return;
    }
    if (answer) {
      // An answer settles the request: a moment's confirmation, then the morning goes on.
      show(answer === 'deny' ? 'denied' : 'allowed');
      return;
    }
    if (folds[current] || isPlace(current)) fold();
    else if (opens[current]) show(opens[current]);
  });

  // Copying anything on the page is a copy like any other.
  document.addEventListener('copy', () => {
    if (current === 'now-playing') return;
    clearTimeout(timer);
    show('copied');
    if (!held && !driven) timer = window.setTimeout(next, 2200);
  });

  document.addEventListener('visibilitychange', () => (document.hidden ? clearTimeout(timer) : !held && hold(false)));

  draw();
  // `#island=<moment>&theme=light&style=notch` holds one moment, for reviewing a state
  // without the loop; the README's pictures are taken this way (/shots).
  const params = new URLSearchParams(location.hash.slice(1));
  const pinned = params.get('island');
  if (params.get('style') === 'notch') style('notch');
  if (params.get('theme') === 'light') theme('light');
  if (pinned) {
    held = true;
    show(pinned);
  } else {
    setTimeout(next, 700);
  }

  // Sections ask for their own moment through this.
  // Click-through, as ReUI is over a browser's tabs: the pill ignores the pointer (so a
  // click reaches the tab under it) until the pointer has rested on it for the hover delay;
  // then it peeks and takes clicks, until the pointer leaves.
  let through = false;
  let resting = 0;
  let rested = false;
  function over(event: PointerEvent) {
    const r = pill.getBoundingClientRect();
    const on = event.clientX >= r.left && event.clientX < r.right && event.clientY >= r.top && event.clientY < r.bottom;
    if (on && !rested && !resting) {
      resting = window.setTimeout(() => {
        resting = 0;
        rested = true;
        root.classList.add('rested');
        peek(true);
      }, 250);
    } else if (!on) {
      clearTimeout(resting);
      resting = 0;
      if (rested) {
        rested = false;
        root.classList.remove('rested');
        peek(false);
        if (folds[current] || isPlace(current)) fold();
      }
    }
  }
  function passThrough(on: boolean) {
    if (on === through) return;
    through = on;
    root.classList.toggle('through', on);
    if (on) addEventListener('pointermove', over, { passive: true });
    else {
      removeEventListener('pointermove', over);
      clearTimeout(resting);
      resting = 0;
      rested = false;
      root.classList.remove('rested');
    }
  }

  /** Moves the island off the edge for a close-up: `drop` px below where it rests (in
   *  either style), `scale`× its size. */
  function stage(drop: number, scale: number) {
    root.style.transform = drop <= 0 && scale === 1 ? '' : `translateY(${drop}px) scale(${scale})`;
  }

  /** Writes a moment's text: `[data-field]` elements by name; `arc` is a ring's progress
   *  (0–1); an empty `query` shows the field's placeholder. */
  function fill(name: string, fields: Record<string, string | number>) {
    const layer = layers.get(name);
    if (!layer) return;
    for (const [key, value] of Object.entries(fields)) {
      const el = layer.querySelector<HTMLElement | SVGElement>(`[data-field="${key}"]`);
      if (!el) continue;
      if (key === 'arc') el.style.strokeDashoffset = String(59.7 * (1 - Number(value)));
      else if (key === 'query') {
        el.textContent = value === '' ? '25m' : String(value);
        el.toggleAttribute('data-empty', value === '');
      } else el.textContent = String(value);
    }
  }

  /** Hides the island (a hide-until-needed mode) or brings it back. */
  function visible(on: boolean) {
    root.classList.toggle('away', !on);
  }

  /** Thins the shape for a moment: a click going through it to the page underneath. */
  function ghost() {
    root.classList.add('ghosted');
    setTimeout(() => root.classList.remove('ghosted'), 450);
  }

  /** ReUI's two styles: floating under the edge, or a notch joined to it. */
  function style(name: 'island' | 'notch') {
    if (notch === (name === 'notch')) return;
    notch = name === 'notch';
    root.classList.toggle('notch', notch);
    target(current, peeking ? PEEK_GROW : 0);
    draw();
  }

  /** The island's theme: dark (the default) or light (tokens theme.light). */
  function theme(name: 'dark' | 'light') {
    root.classList.toggle('light', name === 'light');
  }

  (window as unknown as { island: unknown }).island = { show, hold, drive, stage, passThrough, style, theme, fill, peek, visible, ghost, current: () => current };
</script>
