---
// The footer: where to go next, the background's credit (its CC BY 4.0 licence asks for
// one), and the wordmark as large as the page allows.
import { icons } from '../scripts/icons';

const repo = 'https://github.com/ocopus-labs/ReUI';
const links = [
  { label: 'Download', href: `${repo}/releases/latest` },
  { label: 'Guide', href: `${repo}/blob/main/docs/guide.md` },
  { label: 'What’s new', href: `${repo}/blob/main/CHANGELOG.md` },
  { label: 'Privacy', href: '/privacy' },
  { label: 'License', href: `${repo}#license` },
];
---
<footer class="footer">
  <div class="top">
    <a class="brand" href="/"><img src="/favicon.png" width="22" height="22" alt="" />ReUI</a>
    <nav aria-label="Footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="github" href={repo} aria-label="ReUI on GitHub"><i class="ico" set:html={icons.github}></i></a>
    </nav>
  </div>
  <p class="credit">Free and open source, MIT or Apache 2.0. Product names and logos belong to their owners. Background from <a href="https://www.figma.com/community/file/1626392436817658229/super-visuals-50-stunning-backgrounds-v1">Super Visuals</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
  <p class="wordmark" aria-hidden="true">ReUI</p>
</footer>

<style>
  .footer { position: relative; overflow: hidden; padding: 56px var(--gutter) 0; background: var(--ink); color: #f2f2ee; }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; max-width: 1240px; margin: 0 auto; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 16px; }
  .brand img { border-radius: 5px; }
  nav { display: flex; flex-wrap: wrap; gap: 26px; }
  nav a, .credit a { color: rgb(242 242 238 / 0.65); transition: color 0.2s; }
  nav a:hover, .credit a:hover { color: #fff; }
  nav a { font-size: 15px; }
  nav { align-items: center; }
  .github .ico { width: 20px; height: 20px; }
  .credit { max-width: 1240px; margin: 28px auto 0; color: rgb(242 242 238 / 0.45); font-size: 13px; }
  .credit a { text-decoration: underline; text-underline-offset: 3px; }
  .wordmark { margin: 0; text-align: center; font-size: clamp(140px, 32vw, 460px); font-weight: 700; line-height: 0.78; letter-spacing: -0.07em; color: rgb(242 242 238 / 0.07); transform: translateY(14%); user-select: none; }
</style>
